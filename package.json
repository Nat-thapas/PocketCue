		"svelte-check": "~4.7.8",
		"svelte-sonner": "~1.2.3",
		"tailwind-variants": "~3.3.1",
		"tailwindcss": "~4.3.5",
		"tw-animate-css": "~1.4.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "~8.73.0",
		"vite": "~8.3.8"
